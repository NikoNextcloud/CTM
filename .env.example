# Set only in Vercel Environment Variables or in local .env.local
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# No service_role / secret keys in browser code

# Server-only for admin invitations; only on trusted Vercel/server, NEVER prefix with NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=<configure in secret environment settings>
